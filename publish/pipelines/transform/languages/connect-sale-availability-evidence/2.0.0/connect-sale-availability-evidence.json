{
  "contractVersion": 2,
  "name": "connect-sale-availability-evidence",
  "version": "2.0.0",
  "shape": "tabular",
  "description": "Frozen flat Transform handoff projected from Connect EvidenceRecord v2 at elephant-xyz/connect commit a4f94fe88d82dcc2dca2391acb0cc8deda105d54.",
  "datasets": [
    {
      "type": "run_manifest",
      "description": "One Connect acquisition-run manifest row for the evidence_records dataset.",
      "properties": {
        "contractVersion": {
          "type": "integer",
          "const": 2
        },
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "COMPLETED_WITH_SOURCE_FAILURES"]
        },
        "languageName": {
          "type": "string",
          "const": "connect-sale-availability-evidence"
        },
        "languageVersion": {
          "type": "string",
          "const": "2.0.0"
        },
        "requestUri": {
          "type": "string",
          "pattern": "^s3://"
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providerRegistryUri": {
          "type": "string",
          "pattern": "^s3://"
        },
        "providerRegistrySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceEvidenceUri": {
          "type": "string",
          "pattern": "^s3://"
        },
        "sourceEvidenceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projectedEvidenceUri": {
          "type": "string",
          "pattern": "^s3://"
        },
        "projectedEvidenceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1
        },
        "lookupCount": {
          "type": "integer",
          "const": 1
        },
        "outcomeCountsJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json",
          "minLength": 2
        },
        "providerCountsJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json",
          "minLength": 2
        },
        "publisherCountsJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json",
          "minLength": 2
        },
        "rawArtifactPrefix": {
          "type": "string",
          "pattern": "^s3://"
        }
      },
      "required": [
        "contractVersion",
        "executionId",
        "requestId",
        "startedAt",
        "completedAt",
        "status",
        "languageName",
        "languageVersion",
        "requestUri",
        "requestSha256",
        "providerRegistryUri",
        "providerRegistrySha256",
        "sourceEvidenceUri",
        "sourceEvidenceSha256",
        "projectedEvidenceUri",
        "projectedEvidenceSha256",
        "recordCount",
        "lookupCount",
        "outcomeCountsJson",
        "providerCountsJson",
        "publisherCountsJson",
        "rawArtifactPrefix"
      ],
      "additionalProperties": false,
      "x-invariants": [
        {
          "name": "single_lookup_run",
          "description": "Connect v2 accepts exactly one canonical lookup and emits exactly one run_manifest row.",
          "enforcedBy": ["json-schema", "producer"]
        },
        {
          "name": "artifact_digest_pairs",
          "description": "Every artifact URI is paired with the SHA-256 digest of its exact bytes.",
          "enforcedBy": ["producer"]
        },
        {
          "name": "canonical_count_json",
          "description": "Outcome, provider, and publisher counts remain canonical JSON object strings.",
          "enforcedBy": ["json-schema", "producer"]
        },
        {
          "name": "run_time_order",
          "description": "startedAt is not later than completedAt.",
          "enforcedBy": ["producer"]
        }
      ]
    },
    {
      "type": "evidence_records",
      "description": "Flat scalar projection of every authoritative nested Connect EvidenceRecord v2 observation.",
      "properties": {
        "contractVersion": {
          "type": "integer",
          "const": 2
        },
        "evidenceId": {
          "type": "string",
          "pattern": "^ev_[a-f0-9]{64}$"
        },
        "sourceRequestId": {
          "type": "string",
          "pattern": "^sr_[a-f0-9]{32}$"
        },
        "connectExecutionId": {
          "type": "string",
          "minLength": 1
        },
        "connectRequestId": {
          "type": "string",
          "minLength": 1
        },
        "lookupKeyType": {
          "type": "string",
          "enum": ["address", "parcelId"]
        },
        "lookupCanonicalKey": {
          "type": "string",
          "minLength": 1
        },
        "lookupAddress": {
          "type": ["string", "null"]
        },
        "lookupParcelId": {
          "type": ["string", "null"]
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1
        },
        "evidenceLevel": {
          "type": "string",
          "enum": ["fixture", "live", "deferred"]
        },
        "sourceUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "sourceIdentity": {
          "type": ["string", "null"]
        },
        "publisherId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDomain": {
          "type": ["string", "null"]
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourcePublishedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "httpStatus": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "retrievalOutcome": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "NOT_FOUND",
            "UNSUPPORTED_IDENTITY",
            "DISABLED",
            "BLOCKED",
            "HTTP_ERROR",
            "NETWORK_ERROR",
            "TIMEOUT",
            "CONFIGURATION_ERROR",
            "CONTENT_TYPE_REJECTED",
            "RESPONSE_TOO_LARGE",
            "PARSE_ERROR"
          ]
        },
        "retrievalAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "contentType": {
          "type": ["string", "null"]
        },
        "failureCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "evidenceKind": {
          "type": "string",
          "enum": [
            "exact_listing",
            "complete_index_absence",
            "discovery_only",
            "retrieval_failure"
          ]
        },
        "exactPropertyMatch": {
          "type": ["boolean", "null"]
        },
        "indexCompletenessVerified": {
          "type": "boolean"
        },
        "listingStatus": {
          "type": "string",
          "enum": [
            "for_sale",
            "pending",
            "off_market",
            "not_listed",
            "unknown"
          ]
        },
        "rawStatus": {
          "type": ["string", "null"]
        },
        "askingPriceAmountMinor": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "askingPriceCurrency": {
          "type": ["string", "null"],
          "enum": ["USD", null]
        },
        "askingPriceParseStatus": {
          "type": "string",
          "enum": ["parsed", "absent", "rejected", "not_applicable"]
        },
        "evidenceExcerpt": {
          "type": ["string", "null"]
        },
        "primaryRawArtifactUri": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "primaryRawArtifactSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidenceFieldsJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json",
          "minLength": 2
        },
        "provenanceJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json",
          "minLength": 2
        },
        "sourceRecordJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json",
          "minLength": 2
        },
        "sourceRecordSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contractVersion",
        "evidenceId",
        "sourceRequestId",
        "connectExecutionId",
        "connectRequestId",
        "lookupKeyType",
        "lookupCanonicalKey",
        "lookupAddress",
        "lookupParcelId",
        "providerId",
        "providerVersion",
        "evidenceLevel",
        "sourceUrl",
        "sourceIdentity",
        "publisherId",
        "sourceDomain",
        "retrievedAt",
        "sourcePublishedAt",
        "httpStatus",
        "retrievalOutcome",
        "retrievalAttempts",
        "contentType",
        "failureCode",
        "evidenceKind",
        "exactPropertyMatch",
        "indexCompletenessVerified",
        "listingStatus",
        "rawStatus",
        "askingPriceAmountMinor",
        "askingPriceCurrency",
        "askingPriceParseStatus",
        "evidenceExcerpt",
        "primaryRawArtifactUri",
        "primaryRawArtifactSha256",
        "evidenceFieldsJson",
        "provenanceJson",
        "sourceRecordJson",
        "sourceRecordSha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "lookupKeyType": {
                  "const": "address"
                },
                "lookupAddress": {
                  "type": "string",
                  "minLength": 1
                },
                "lookupParcelId": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "lookupKeyType": {
                  "const": "parcelId"
                },
                "lookupAddress": {
                  "type": "null"
                },
                "lookupParcelId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "primaryRawArtifactUri": {
                  "type": "null"
                },
                "primaryRawArtifactSha256": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "primaryRawArtifactUri": {
                  "type": "string",
                  "format": "uri"
                },
                "primaryRawArtifactSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "askingPriceParseStatus": {
                "const": "parsed"
              }
            }
          },
          "then": {
            "properties": {
              "askingPriceAmountMinor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "askingPriceCurrency": {
                "const": "USD"
              },
              "retrievalOutcome": {
                "const": "SUCCESS"
              },
              "evidenceKind": {
                "const": "exact_listing"
              },
              "exactPropertyMatch": {
                "const": true
              },
              "listingStatus": {
                "const": "for_sale"
              }
            }
          },
          "else": {
            "properties": {
              "askingPriceAmountMinor": {
                "type": "null"
              },
              "askingPriceCurrency": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "listingStatus": {
                "const": "for_sale"
              },
              "exactPropertyMatch": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "askingPriceParseStatus": {
                "enum": ["parsed", "absent", "rejected"]
              }
            }
          },
          "else": {
            "properties": {
              "askingPriceParseStatus": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "listingStatus": {
                "const": "not_listed"
              }
            }
          },
          "then": {
            "properties": {
              "retrievalOutcome": {
                "const": "SUCCESS"
              },
              "evidenceKind": {
                "const": "complete_index_absence"
              },
              "exactPropertyMatch": {
                "const": false
              },
              "indexCompletenessVerified": {
                "const": true
              },
              "askingPriceAmountMinor": {
                "type": "null"
              },
              "askingPriceCurrency": {
                "type": "null"
              },
              "askingPriceParseStatus": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidenceKind": {
                "const": "retrieval_failure"
              }
            }
          },
          "then": {
            "properties": {
              "retrievalOutcome": {
                "enum": [
                  "NOT_FOUND",
                  "UNSUPPORTED_IDENTITY",
                  "DISABLED",
                  "BLOCKED",
                  "HTTP_ERROR",
                  "NETWORK_ERROR",
                  "TIMEOUT",
                  "CONFIGURATION_ERROR",
                  "CONTENT_TYPE_REJECTED",
                  "RESPONSE_TOO_LARGE",
                  "PARSE_ERROR"
                ]
              },
              "exactPropertyMatch": {
                "type": "null"
              },
              "indexCompletenessVerified": {
                "const": false
              },
              "listingStatus": {
                "const": "unknown"
              },
              "askingPriceAmountMinor": {
                "type": "null"
              },
              "askingPriceCurrency": {
                "type": "null"
              },
              "askingPriceParseStatus": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidenceKind": {
                "const": "discovery_only"
              }
            }
          },
          "then": {
            "properties": {
              "retrievalOutcome": {
                "const": "SUCCESS"
              },
              "exactPropertyMatch": {
                "enum": [false, null]
              },
              "indexCompletenessVerified": {
                "const": false
              },
              "listingStatus": {
                "const": "unknown"
              },
              "askingPriceAmountMinor": {
                "type": "null"
              },
              "askingPriceCurrency": {
                "type": "null"
              },
              "askingPriceParseStatus": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidenceKind": {
                "const": "complete_index_absence"
              }
            }
          },
          "then": {
            "properties": {
              "retrievalOutcome": {
                "const": "SUCCESS"
              },
              "exactPropertyMatch": {
                "const": false
              },
              "indexCompletenessVerified": {
                "const": true
              },
              "listingStatus": {
                "const": "not_listed"
              },
              "askingPriceParseStatus": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidenceKind": {
                "const": "exact_listing"
              }
            }
          },
          "then": {
            "properties": {
              "retrievalOutcome": {
                "const": "SUCCESS"
              },
              "exactPropertyMatch": {
                "const": true
              },
              "listingStatus": {
                "enum": ["for_sale", "pending", "off_market", "unknown"]
              }
            }
          }
        }
      ],
      "x-invariants": [
        {
          "name": "positive_safe_integer_price",
          "description": "askingPriceAmountMinor is null or a positive JavaScript-safe integer number of USD cents.",
          "enforcedBy": ["json-schema", "mapping-sql", "producer"]
        },
        {
          "name": "structured_price_authority",
          "description": "Only an exact successful for-sale listing with parse status parsed can carry amount and USD currency.",
          "enforcedBy": ["json-schema", "mapping-sql", "producer"]
        },
        {
          "name": "canonical_nested_audit_json",
          "description": "evidenceFieldsJson, provenanceJson, and sourceRecordJson are retained as canonical JSON strings; nested citations are not emitted as rows in this language version.",
          "enforcedBy": ["json-schema", "producer"]
        },
        {
          "name": "source_record_digest",
          "description": "sourceRecordSha256 is the SHA-256 digest of the exact UTF-8 sourceRecordJson string.",
          "enforcedBy": ["producer"]
        },
        {
          "name": "evidence_identity",
          "description": "evidenceId remains the producer content identity and excludes Connect run IDs.",
          "enforcedBy": ["producer"]
        }
      ]
    }
  ]
}
