{
  "contractVersion": 2,
  "name": "connect-http-acquisition",
  "version": "1.0.0",
  "shape": "tabular",
  "description": "Generic Connect HTTP acquisition metadata plus the Transform-derived raw_documents hydration dataset. Connect owns transport and immutable raw bytes; no business interpretation is present.",
  "datasets": [
    {
      "type": "run_manifest",
      "properties": {
        "contractVersion": { "type": "integer", "const": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "COMPLETED_WITH_FAILURES"]
        },
        "languageName": {
          "type": "string",
          "const": "connect-http-acquisition"
        },
        "languageVersion": { "type": "string", "const": "1.0.0" },
        "requestUri": { "type": "string", "pattern": "^s3://" },
        "requestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registryUri": { "type": "string", "pattern": "^s3://" },
        "registrySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acquisitionsUri": { "type": "string", "pattern": "^s3://" },
        "acquisitionsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projectedAcquisitionsUri": {
          "type": "string",
          "pattern": "^s3://"
        },
        "projectedAcquisitionsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recordCount": { "type": "integer", "minimum": 1 },
        "outcomeCountsJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "publisherCountsJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "rawArtifactPrefix": { "type": "string", "pattern": "^s3://" }
      },
      "required": [
        "contractVersion",
        "runId",
        "requestId",
        "startedAt",
        "completedAt",
        "status",
        "languageName",
        "languageVersion",
        "requestUri",
        "requestSha256",
        "registryUri",
        "registrySha256",
        "acquisitionsUri",
        "acquisitionsSha256",
        "projectedAcquisitionsUri",
        "projectedAcquisitionsSha256",
        "recordCount",
        "outcomeCountsJson",
        "publisherCountsJson",
        "rawArtifactPrefix"
      ],
      "additionalProperties": false
    },
    {
      "type": "acquisition_records",
      "properties": {
        "contractVersion": { "type": "integer", "const": 1 },
        "acquisitionId": {
          "type": "string",
          "pattern": "^acq_[a-f0-9]{64}$"
        },
        "operationRequestId": {
          "type": "string",
          "pattern": "^or_[a-f0-9]{32}$"
        },
        "runId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "operationId": { "type": "string", "minLength": 1 },
        "registrationId": { "type": "string", "minLength": 1 },
        "registrationVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "contextJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "contextSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publisherId": { "type": "string", "minLength": 1 },
        "domain": { "type": ["string", "null"] },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "requestHeaderNamesJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "requestQuerySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestBodySha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "sourcePublishedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "httpStatus": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "contentType": { "type": ["string", "null"] },
        "contentLength": { "type": ["integer", "null"], "minimum": 0 },
        "outcome": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "NOT_FOUND",
            "DISABLED",
            "BLOCKED",
            "HTTP_ERROR",
            "NETWORK_ERROR",
            "TIMEOUT",
            "CONFIGURATION_ERROR",
            "CONTENT_TYPE_REJECTED",
            "RESPONSE_TOO_LARGE",
            "PARSE_ERROR"
          ]
        },
        "attempts": { "type": "integer", "minimum": 0 },
        "failureCode": { "type": ["string", "null"] },
        "primaryRawArtifactUri": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "primaryRawArtifactSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "rawArtifactCount": { "type": "integer", "minimum": 0 },
        "robotsArtifactUri": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "robotsArtifactSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "parentAcquisitionId": {
          "type": ["string", "null"],
          "pattern": "^acq_[a-f0-9]{64}$"
        },
        "redirectChainJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "paginationUrlsJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "provenanceJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "sourceRecordJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "sourceRecordSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contractVersion",
        "acquisitionId",
        "operationRequestId",
        "runId",
        "requestId",
        "operationId",
        "registrationId",
        "registrationVersion",
        "contextJson",
        "contextSha256",
        "inputJson",
        "inputSha256",
        "publisherId",
        "domain",
        "sourceUrl",
        "method",
        "requestHeaderNamesJson",
        "requestQuerySha256",
        "requestBodySha256",
        "retrievedAt",
        "sourcePublishedAt",
        "httpStatus",
        "contentType",
        "contentLength",
        "outcome",
        "attempts",
        "failureCode",
        "primaryRawArtifactUri",
        "primaryRawArtifactSha256",
        "rawArtifactCount",
        "robotsArtifactUri",
        "robotsArtifactSha256",
        "parentAcquisitionId",
        "redirectChainJson",
        "paginationUrlsJson",
        "provenanceJson",
        "sourceRecordJson",
        "sourceRecordSha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "raw_documents",
      "description": "Transform-derived rows hydrated only from authorized, digest-verified S3/local artifacts.",
      "properties": {
        "acquisitionId": {
          "type": "string",
          "pattern": "^acq_[a-f0-9]{64}$"
        },
        "artifactOrdinal": { "type": "integer", "minimum": 0 },
        "artifactRole": {
          "type": "string",
          "enum": ["raw", "robots", "discovery"]
        },
        "registrationId": { "type": "string", "minLength": 1 },
        "publisherId": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "sourceUri": { "type": "string", "pattern": "^s3://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contentType": { "type": ["string", "null"] },
        "bodyText": { "type": ["string", "null"] },
        "bodyLength": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "acquisitionId",
        "artifactOrdinal",
        "artifactRole",
        "registrationId",
        "publisherId",
        "sourceUrl",
        "sourceUri",
        "sha256",
        "contentType",
        "bodyText",
        "bodyLength"
      ],
      "additionalProperties": false
    }
  ]
}
