          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "publisherCountsJson": {
          "type": "string",
          "format": "canonical-json",
          "contentMediaType": "application/json"
        },
        "rawArtifactPrefix": { "type": "string", "pattern": "^s3://" },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
