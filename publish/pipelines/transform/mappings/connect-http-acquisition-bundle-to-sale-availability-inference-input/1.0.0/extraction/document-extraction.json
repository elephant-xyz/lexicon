        },
        {
          "name": "priceMajor",
          "value": { "kind": "attribute", "name": "data-price" },
          "required": true
        },
        {
          "name": "mlsId",
          "value": { "kind": "attribute", "name": "data-mls" },
          "required": true
        },
        {
          "name": "rawStatus",
          "value": { "kind": "attribute", "name": "data-status" },
          "required": true
        }
      ]
    }
