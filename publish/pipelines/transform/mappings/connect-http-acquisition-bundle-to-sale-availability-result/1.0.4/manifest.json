              "sha256": "f92ba5b0910a105898ad2556f2d0f9b0e766e2a000c3b655b0dec91a8189b0bd",
              "description": "Pins deterministic page identities and replay while bounded extraction evaluates first, later, top-level-array, and @graph JSON-LD blocks without changing source page cardinality."
            }
          ]
        },
        {
          "invariant": "rejected_price_is_null",
          "querySha256s": [
            "cb41d294b44f03386b5fb30c71304bb3477814d315e5f8bbc0ccd3bf69d8d21f"
          ],
          "tests": [
            {
              "path": "tests/firecrawl-policy-v3-cases.json",
              "sha256": "f92ba5b0910a105898ad2556f2d0f9b0e766e2a000c3b655b0dec91a8189b0bd",
              "description": "Pins price only from one eligible exact, fresh, explicitly active structured block and nulls missing-currency, stale, non-exact, malformed, over-limit, text-only, application-state-only, and conflicting evidence. Freshness uses dateModified, then lastReviewed, then the retrieval time of a provably live (cacheState miss, no cachedAt, HTTP 200) fetch; datePosted and datePublished never establish freshness. A visible pending, contingent, under-contract, under-agreement, auction, off-market, sold or not-currently-for-sale label before the displayed price, or an explicit inactive structured listing status in the same block, outranks InStock. A price labelled as an estimate, rent, assessed value or auction bid is neither a list price nor an active signal; a price labelled as an offer, or equal to the page's own offer or estimate amount and not to its list price, is rejected."
            }
          ]
        },
        {
          "invariant": "relationship_endpoints_exist",
          "querySha256s": [
            "cb41d294b44f03386b5fb30c71304bb3477814d315e5f8bbc0ccd3bf69d8d21f"
          ],
          "tests": [
            {
              "path": "tests/firecrawl-policy-v3-cases.json",
              "sha256": "f92ba5b0910a105898ad2556f2d0f9b0e766e2a000c3b655b0dec91a8189b0bd",
              "description": "Pins the existing address, FileRef, optional independent-property endpoints, and one deterministic sentinel observation for empty or failed envelopes."
            }
          ],
          "engineChecks": [
            {
              "kind": "array-sorted-unique",
              "jsonPointer": "/relationships/listing_observation_has_file"
            }
          ]
        }
      ]
    },
