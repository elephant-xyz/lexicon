              "path": "tests/firecrawl-policy-v3-cases.json",
              "sha256": "f92ba5b0910a105898ad2556f2d0f9b0e766e2a000c3b655b0dec91a8189b0bd",
              "description": "Pins the existing address, sorted observation, and optional independently established property relationships."
            }
          ]
        },
        {
          "invariant": "eligible_list_price_projection",
          "querySha256s": [
            "68153d8d9eb3d6274b375d38af370a812f44e848096d7406c504f24129c16d9c"
