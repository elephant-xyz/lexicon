          ],
          "tests": [
            {
              "path": "tests/firecrawl-policy-v3-cases.json",
              "sha256": "f92ba5b0910a105898ad2556f2d0f9b0e766e2a000c3b655b0dec91a8189b0bd",
              "description": "Pins ascending unique observation references across one-page, three-page, malformed, bounded-limit, and sentinel assessments."
