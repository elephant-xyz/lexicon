# Runtime: public Filebase IPNS network key (k51...) for the latest manifest.
LEXICON_MANIFEST_IPNS=

# Publisher only. Configure these as GitHub environment secrets/variables, not
# in a committed .env file.
CONFIRM_FILEBASE_PUBLISH=
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_LEXICON_BUCKET=
FILEBASE_LEXICON_IPNS_LABEL=elephant-lexicon-manifest
# Optional override; defaults to the current Filebase S3 endpoint.
FILEBASE_S3_ENDPOINT=https://s3.filebase.com
