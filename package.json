{
  "name": "lexicon-view",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-sfn": "^3.1148.0",
    "@aws-sdk/client-ssm": "^3.1148.0",
    "@aws-sdk/credential-provider-node": "^3.972.84",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^1.2.1",
    "lz-string": "^1.5.0",
    "prism-react-renderer": "^1.3.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.6.2",
    "serverless-plugin-resource-tagging": "1.1.0",
    "web-vitals": "^2.1.4",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:model": "vitest run tests/model",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit && npm run typecheck:model",
    "typecheck:model": "tsc -p tsconfig.model.json",
    "cdk:synth": "cdk synth --strict",
    "cdk:diff": "cdk diff --no-change-set",
    "model:deploy": "tsx model/scripts/deploy.ts",
    "model:request": "tsx model/scripts/request.ts",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:lint": "npm run lint && npm run format:check",
    "ci:fix": "npm run lint:fix && npm run format"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.8.1",
    "dotenv": "^17.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "json-canonicalize": "^2.0.0",
    "prettier": "^3.6.2",
    "serverless-pseudo-parameters": "2.5.0",
    "serverless-python-requirements": "^5.1.1",
    "serverless-scriptable-plugin": "1.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
